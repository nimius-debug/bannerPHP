define( 'LL_FREE_SHIPPING_THRESHOLD', 125 );

function ll_render_free_shipping_progress_bar() {
    if ( ! class_exists( 'WooCommerce' ) || ! WC()->cart ) return '';

    $cart = WC()->cart;
    $cart_has_items = ! $cart->is_empty();

    $threshold = LL_FREE_SHIPPING_THRESHOLD;
    $subtotal  = 0;

    if ( $cart_has_items ) {
        $subtotal = $cart->get_subtotal();
    }

    $remaining = max( 0, $threshold - $subtotal );
    $percent   = ($threshold > 0) ? min( 100, ( $subtotal / $threshold ) * 100 ) : 0;

    ob_start();
    ?>
    <div id="ll-shipping-progress-wrapper" class="cart-progress-bar-container">
        <?php if ( $cart_has_items ) : ?>
            <div class="ll-shipping-inner">
                <div class="ll-shipping-text">
                    <?php if ( $subtotal >= $threshold ) : ?>
                        <span class="ll-shipping-emoji">🚚</span>
                        <span class="ll-shipping-message">
                            You’ve unlocked <strong>free shipping</strong> on your order! 💘
                        </span>
                    <?php else : ?>
                        <span class="ll-shipping-emoji">✨</span>
                        <span class="ll-shipping-message">
                           Spend <strong class="ll-remaining-price"><?php echo wc_price( $remaining ); ?></strong> more to unlock free shipping.
                        </span>
                    <?php endif; ?>
                </div>

                <div class="ll-shipping-bar-outer">
                    <div class="ll-shipping-bar-inner" style="width: <?php echo esc_attr( $percent ); ?>%;"></div>
                </div>
            </div>
        <?php endif; ?>
    </div>

    <style>
        .cart-progress-bar-container {
            --vday-rose: #E11D48;
            --vday-blush: #FB7185;
            --vday-border: rgba(255,228,230,0.18);

            padding: 15px 0;
            margin-bottom: 20px;
            background: #000;
            border: 1px solid var(--vday-border);
            color: #fff;
            font-family: "Helvetica Neue", Arial, sans-serif;
            position: relative;
            overflow: hidden;
            border-radius: 12px;
        }

        .cart-progress-bar-container:before{
            content:"";
            position:absolute;
            left:0; right:0; top:0;
            height:2px;
            background: linear-gradient(90deg, transparent, var(--vday-rose), var(--vday-blush), transparent);
            opacity: 0.85;
        }

        .ll-shipping-message strong.ll-remaining-price .woocommerce-Price-amount,
        .ll-shipping-message strong.ll-remaining-price .woocommerce-Price-currencySymbol {
            color: var(--vday-blush) !important;
            text-decoration: none !important;
        }

        .ll-shipping-inner {
            max-width: 1100px;
            margin: 0 auto;
            padding: 0 15px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .ll-shipping-text {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            font-size: 14px;
            text-align: center;
        }

        .ll-shipping-message strong {
            font-weight: 800;
            color: #fff;
            text-decoration: underline;
            text-decoration-color: var(--vday-blush);
            text-underline-offset: 3px;
        }

        .ll-shipping-emoji { font-size: 18px; }

        .ll-shipping-bar-outer {
            width: 100%;
            height: 7px;
            border-radius: 999px;
            background: rgba(255,228,230,0.14);
            overflow: hidden;
            box-shadow: inset 0 0 0 1px rgba(255,228,230,0.10);
        }

        .ll-shipping-bar-inner {
            height: 100%;
            border-radius: 999px;
            background: linear-gradient(90deg, var(--vday-rose), var(--vday-blush));
            transition: width 0.5s ease-in-out;
            box-shadow: 0 0 14px rgba(225,29,72,0.25);
        }

        @media (max-width: 600px) {
            .ll-shipping-text { font-size: 12px; flex-direction: column; gap: 2px; }
            .ll-shipping-emoji { display: none; }
        }
    </style>
    <?php
    return ob_get_clean();
}

