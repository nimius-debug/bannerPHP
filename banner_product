// --- CONFIGURATION ---
define( 'LL_FREE_GIFT_ID', 5083 ); 
define( 'LL_FREE_GIFT_THRESHOLD', 250 );

// --- LOGIC: Add/Remove Free Gift ---
add_action( 'woocommerce_before_calculate_totals', 'll_check_free_gift_threshold', 20 );
function ll_check_free_gift_threshold( $cart ) {
    if ( is_admin() && ! defined( 'DOING_AJAX' ) ) return;
    if ( ! LL_FREE_GIFT_ID || ! LL_FREE_GIFT_THRESHOLD ) return;

    $threshold = LL_FREE_GIFT_THRESHOLD;
    $gift_id   = LL_FREE_GIFT_ID;

    $subtotal = 0;
    $gift_key = false;

    foreach ( $cart->get_cart() as $key => $item ) {
        if ( (int) $item['product_id'] === (int) $gift_id ) {
            $gift_key = $key;
        } else {
            $subtotal += $item['line_subtotal'];
        }
    }

    if ( $subtotal >= $threshold ) {
        // Add gift if missing
        if ( ! $gift_key ) {
            $gift_key = $cart->add_to_cart( $gift_id, 1, 0, array(), array( 'll_is_free_gift' => true ) );
        }
        // Force price to 0
        if ( $gift_key && isset( $cart->cart_contents[ $gift_key ] ) ) {
            $cart->cart_contents[ $gift_key ]['data']->set_price( 0 );
            $cart->cart_contents[ $gift_key ]['ll_is_free_gift'] = true;
        }
    } else {
        // Remove gift if present
        if ( $gift_key ) {
            $cart->remove_cart_item( $gift_key );
        }
    }
}

// Visuals: Show $0.00 price
add_filter( 'woocommerce_cart_item_price', 'll_display_free_gift_price', 10, 3 );
function ll_display_free_gift_price( $price, $cart_item, $cart_item_key ) {
    if ( isset( $cart_item['ll_is_free_gift'] ) && $cart_item['ll_is_free_gift'] ) {
        return wc_price( 0 );
    }
    return $price;
}

add_filter( 'woocommerce_cart_item_subtotal', 'll_display_free_gift_subtotal', 10, 3 );
function ll_display_free_gift_subtotal( $subtotal, $cart_item, $cart_item_key ) {
    if ( isset( $cart_item['ll_is_free_gift'] ) && $cart_item['ll_is_free_gift'] ) {
        return wc_price( 0 );
    }
    return $subtotal;
}

// --- VISUALS: The Progress Bar Function ---
function ll_render_free_gift_progress_bar() {
    if ( ! class_exists( 'WooCommerce' ) || ! WC()->cart ) return '';

    $cart = WC()->cart;
    $cart_has_items = ! $cart->is_empty();

    $threshold = LL_FREE_GIFT_THRESHOLD;
    $subtotal  = 0;

    // Calculate subtotal excluding gift
    if ( $cart_has_items ) {
        foreach ( $cart->get_cart() as $item ) {
            if ( (int) $item['product_id'] === (int) LL_FREE_GIFT_ID ) continue;
            $subtotal += $item['line_subtotal'];
        }
    }

    $remaining = max( 0, $threshold - $subtotal );
    $percent   = ($threshold > 0) ? min( 100, ( $subtotal / $threshold ) * 100 ) : 0;
    
    ob_start();
    ?>
    <div id="ll-gift-progress-wrapper" class="cart-progress-bar-container">
        <?php if ( $cart_has_items ) : // Only show content if the cart is NOT empty ?>
            <div class="ll-gift-inner">
                <div class="ll-gift-text">
                    <?php if ( $subtotal >= $threshold ) : ?>
                        <span class="ll-gift-emoji">🎁</span>
                        <span class="ll-gift-message">
                            You’ve unlocked your **complimentary gift** — it’s been added to your cart for $0.
                        </span>
                    <?php else : ?>
                        <span class="ll-gift-emoji">✨</span>
                        <span class="ll-gift-message">
                            Spend **<?php echo wc_price( $remaining ); ?>** more in skincare to receive a complimentary gift.
                        </span>
                    <?php endif; ?>
                </div>

                <div class="ll-gift-bar-outer">
                    <div class="ll-gift-bar-inner" style="width: <?php echo esc_attr( $percent ); ?>%;"></div>
                </div>
            </div>
        <?php else : ?>
            <?php endif; ?>
    </div>

    <style>
        .cart-progress-bar-container {
            /* Styles for the bar container when placed inside the cart/mini-cart */
            padding: 15px 0;
            margin-bottom: 20px; /* Adds space below the bar on the cart page */
            background: #000;
            border: 1px solid #222;
            color: #fff;
            font-family: "Helvetica Neue", Arial, sans-serif;
        }
        
        /* The rest of the styles remain mostly the same */
