// --- AJAX: Update the bar when cart changes ---
add_filter( 'woocommerce_add_to_cart_fragments', 'll_refresh_gift_progress_bar_fragment' );
function ll_refresh_gift_progress_bar_fragment( $fragments ) {
    // The key MUST match the wrapper ID
    $fragments['#ll-gift-progress-wrapper'] = ll_render_free_gift_progress_bar();
    return $fragments;
}

